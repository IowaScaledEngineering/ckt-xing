#!/bin/bash
ISPL_TOOLS=../../../ispltools/tools/
PYTHON=python3
AUDIO_IMG=rele
AVR_IMG=./release-firmware/ckt-xing-adv-111f64f-10Oct2026.hex
AUDIO_IMG=./release-firmware/ckt-xing-adv-111f64f-10Oct2026.sbp

# if less than two arguments supplied, display usage 
if [  $# -ge 1 ] 
then 
	echo "Usage: ./program"
	exit 1
fi 


while [ true ]
do
	read -p "Set switch to AVR and press any key to program..."
	echo -e "\n\033[1;33mProgramming AVR\033[0m\n"
	make -C . fuse FIRMWARE_IMG="$AVR_IMG"
	make -C . flash FIRMWARE_IMG="$AVR_IMG"
	if [ $? -eq 0 ]
	then 
		echo -e "\033[0;32mSuccess\033[0m\n"
	else 
		echo -e "\033[0;31mFailed\033[0m\n"
		espeak "A V R Failed"
		continue
	fi

	while [ true ]
	do
		read -p "Set switch to FLASH and press any key to program..."
		echo -e "\n\033[1;33mProgramming Flash\033[0m\n"
		$PYTHON $ISPL_TOOLS/spiflash-pyprog/flash.py $AUDIO_IMG
		if [ $? -eq 0 ]
		then 
			echo -e "\033[0;32mComplete\033[0m\n"
			espeak "Complete"
			break
		else 
			echo -e "\033[0;31mFailed\033[0m\n"
			espeak "Audio Flash Failed"
			continue
		fi
	done

	sleep 1

done
